{
  "name": "angular-boilerplate",
  "version": "0.0.0",
  "private": true,
  "description": "Angular 20 SaaS boilerplate / starter kit with SSR, TypeScript and Tailwind CSS 4: GitHub OAuth + magic-link auth, admin RBAC, Drizzle + Postgres, Polar billing, Resend email, i18n and a full dashboard. Every integration is env-gated.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uday-a/angular-boilerplate.git"
  },
  "homepage": "https://uipkge.dev",
  "keywords": [
    "angular",
    "angular-20",
    "angular-ssr",
    "saas",
    "saas-boilerplate",
    "saas-starter",
    "starter-kit",
    "boilerplate",
    "typescript",
    "tailwindcss",
    "tailwindcss-v4",
    "express",
    "drizzle-orm",
    "postgres",
    "polar",
    "resend",
    "rbac",
    "i18n",
    "dashboard",
    "uipkge"
  ],
  "type": "module",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "ng serve --port 4201 --proxy-config proxy.conf.json",
    "dev:api": "tsx watch server/dev-api.ts",
    "build": "ng build",
    "start": "node dist/angular-boilerplate/server/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/platform-server": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@angular/ssr": "^20.3.37",
    "@axiomhq/js": "^1.8.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@polar-sh/sdk": "^0.49.0",
    "@sentry/angular": "^11.0.0",
    "@sentry/node": "^11.1.0",
    "arctic": "^3.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "express": "^5.1.0",
    "iron-session": "^9.0.0",
    "leaflet": "^1.9.4",
    "lucide-angular": "^1.0.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.417.0",
    "resend": "^6.20.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.33",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.17.19",
    "concurrently": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.7"
  }
}
